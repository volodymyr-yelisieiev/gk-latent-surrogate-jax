{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/volodymyr-yelisieiev/gk-latent-surrogate-jax/blob/main/experiment_protocols/release_manifest.schema.json",
  "title": "GK latent-surrogate sanitized multi-seed release manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "release_manifest_schema_version",
    "status",
    "protocol_id",
    "protocol_sha256",
    "source_tag",
    "source_commit",
    "analysis_commit",
    "analysis_tracked_diff_sha256",
    "dataset_revision",
    "universe_manifest_sha256",
    "universe_trajectory_ids_sha256",
    "outer_fold_manifest_sha256",
    "selection",
    "primary",
    "secondary",
    "seed_variability",
    "bootstrap",
    "outer_fold_summary",
    "stage_counts",
    "artifact_sha256",
    "wandb_status",
    "provenance"
  ],
  "properties": {
    "release_manifest_schema_version": {"const": "1.0.0"},
    "status": {"const": "accepted"},
    "protocol_id": {"const": "multiseed-v1"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_tag": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "analysis_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "analysis_tracked_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_revision": {"type": "string", "minLength": 1},
    "universe_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "universe_trajectory_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outer_fold_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection": {"type": "object"},
    "primary": {"type": "object"},
    "secondary": {"type": "object"},
    "seed_variability": {"type": "array"},
    "bootstrap": {"type": "object"},
    "outer_fold_summary": {"type": "array", "minItems": 5, "maxItems": 5},
    "stage_counts": {"type": "object"},
    "stage_config_resolved_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "artifact_sha256": {"type": "object"},
    "wandb_status": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
