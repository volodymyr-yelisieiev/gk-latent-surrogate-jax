{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/volodymyr-yelisieiev/gk-latent-surrogate-jax/blob/main/experiment_protocols/results.schema.json",
  "title": "GK latent-surrogate nested-CV result manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "result_schema_version",
    "status",
    "protocol_id",
    "protocol_sha256",
    "source_tag",
    "source_commit",
    "analysis_commit",
    "analysis_tracked_diff_sha256",
    "dataset_revision",
    "universe_manifest_sha256",
    "outer_fold_manifest_sha256",
    "selection",
    "primary_estimand",
    "bootstrap",
    "primary",
    "secondary",
    "seed_summary",
    "seed_variability",
    "outer_fold_summary",
    "stage_ledger",
    "artifacts",
    "wandb_status"
  ],
  "properties": {
    "result_schema_version": {"const": "1.0.0"},
    "status": {"const": "accepted"},
    "protocol_id": {"const": "multiseed-v1"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_tag": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "analysis_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "analysis_tracked_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_revision": {"type": "string", "minLength": 1},
    "universe_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outer_fold_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection": {"type": "object"},
    "primary_estimand": {"type": "string", "minLength": 1},
    "bootstrap": {"type": "object"},
    "primary": {"type": "object"},
    "secondary": {"type": "object"},
    "seed_summary": {"type": "array", "minItems": 25, "maxItems": 25},
    "seed_variability": {"type": "array", "minItems": 5, "maxItems": 5},
    "outer_fold_summary": {"type": "array", "minItems": 5, "maxItems": 5},
    "stage_ledger": {"type": "array", "minItems": 255, "maxItems": 255},
    "artifacts": {"type": "object"},
    "wandb_status": {"type": "object"}
  }
}
